    (comp (ref "D2") (value "SMBJ33A") (footprint "Diode_SMD:D_SMB")
      (fields (field (name "desc") "TVS clamp on VIN rail")))
    (comp (ref "C1") (value "470uF/35V") (footprint "Capacitor_SMD:CP_Elec_10x10.5")
      (fields (field (name "desc") "VIN bulk reservoir")))
    (comp (ref "C2") (value "100nF") (footprint "Capacitor_SMD:C_0805_2012Metric")
      (fields (field (name "desc") "VIN HF decoupling")))
    (comp (ref "U1") (value "LM2596S-12") (footprint "Package_TO_SOT_SMD:TO-263-5_TabPin3")
