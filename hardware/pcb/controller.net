    (comp (ref "D3") (value "SS54") (footprint "Diode_SMD:D_SMC")
      (fields (field (name "desc") "Buck freewheel diode")))
    (comp (ref "C3") (value "220uF/25V") (footprint "Capacitor_SMD:CP_Elec_8x10")
      (fields (field (name "desc") "12V output bulk")))
    (comp (ref "U2") (value "78L05") (footprint "Package_TO_SOT_SMD:SOT-89-3")
      (fields (field (name "desc") "5V MCU LDO from 12V")))
    (comp (ref "C4") (value "10uF/16V") (footprint "Capacitor_SMD:C_0805_2012Metric")
